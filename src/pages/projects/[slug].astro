---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/portfolio';
import { sitePath } from '../../utils/paths';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — 项目`} description={project.description}><article class="mx-auto max-w-3xl px-5 py-20 lg:px-8 lg:py-28"><a class="font-mono text-sm text-muted hover:text-copy" href={sitePath('/projects/')}>← 全部项目</a><p class="mt-12 font-mono text-sm text-accent">{project.category}</p><h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{project.title}</h1><p class="mt-6 text-xl leading-8 text-muted">{project.description}</p><div class="mt-8 flex flex-wrap gap-2">{project.stack.map((item) => <span class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{item}</span>)}</div><div class="mt-16 space-y-10 border-t border-line pt-10"><section><h2 class="text-xl font-semibold">项目背景</h2><p class="mt-3 leading-8 text-muted">{project.context}</p></section><section><h2 class="text-xl font-semibold">我的贡献</h2><p class="mt-3 leading-8 text-muted">{project.contribution}</p></section><section><h2 class="text-xl font-semibold">项目亮点</h2><ul class="mt-3 list-disc space-y-2 pl-5 leading-8 text-muted">{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></section></div></article></BaseLayout>
