---
interface Props { headings: { depth: number; slug: string; text: string }[] }
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth <= 3);
---
{items.length > 0 && <nav aria-label="Table of contents" class="rounded-2xl border border-line bg-surface p-5"><p class="font-mono text-xs uppercase tracking-wider text-muted">On this page</p><ol class="mt-4 space-y-2 text-sm">{items.map((heading) => <li class:list={[heading.depth === 3 ? 'pl-3' : '']}><a href={`#${heading.slug}`} class="text-muted hover:text-copy">{heading.text}</a></li>)}</ol></nav>}
