---
interface Props { tags: string[] }
import { slugifyTag } from '../utils/content';
import { sitePath } from '../utils/paths';
const { tags } = Astro.props;
---
<div class="flex flex-wrap gap-2">{tags.map((tag) => <a href={sitePath(`/tags/${slugifyTag(tag)}/`)} class="rounded-full bg-page px-3 py-1 font-mono text-xs text-muted transition hover:text-copy">#{tag}</a>)}</div>
