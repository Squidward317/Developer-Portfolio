---
interface Props { eyebrow: string; title: string; description?: string }
const { eyebrow, title, description } = Astro.props;
---
<div class="mb-10 max-w-2xl"><p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">{eyebrow}</p><h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>{description && <p class="mt-4 leading-7 text-muted">{description}</p>}</div>
